{
	"name": "nitro-better-auth",
	"type": "module",
	"version": "0.3.1",
	"packageManager": "pnpm@11.22.0",
	"author": "zhong666 <hi@zhong666.me>",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/aa900031/nitro-better-auth"
	},
	"keywords": [
		"nitro",
		"better-auth",
		"auth",
		"nitro-module"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		}
	},
	"main": "./dist/index.mjs",
	"typesVersions": {
		"*": {
			".": [
				"./dist/index.d.mts"
			]
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown",
		"dev": "run-p 'dev:*'",
		"dev:plugin": "tsdown --watch",
		"dev:playground": "wait-on ./dist/index.mjs && nitro dev --dir playground",
		"release": "release-it",
		"lint": "eslint .",
		"test": "vitest run",
		"test:types": "tsc --noEmit"
	},
	"peerDependencies": {
		"better-auth": "^1.2.0",
		"chokidar": "^4.0.3 || ^5.0.0",
		"defu": "^6.1.4",
		"knitwork": "^1.2.0",
		"nitropack": "^2.11.13",
		"pathe": "^2.0.3"
	},
	"peerDependenciesMeta": {
		"chokidar": {
			"optional": true
		},
		"defu": {
			"optional": true
		},
		"knitwork": {
			"optional": true
		},
		"pathe": {
			"optional": true
		}
	},
	"devDependencies": {
		"@aa900031/eslint-config": "^8.0.3",
		"@aa900031/release-it-config": "^1.0.0",
		"@tsconfig/node24": "^24.0.0",
		"@types/node": "^26.3.0",
		"@vitest/coverage-istanbul": "^4.1.11",
		"better-auth": "^1.7.1",
		"chokidar": "^5.0.0",
		"defu": "^6.1.7",
		"eslint": "^10.9.1",
		"knitwork": "^1.3.0",
		"nitropack": "^2.13.4",
		"npm-run-all2": "^9.0.3",
		"pathe": "^2.0.3",
		"release-it": "^20.2.1",
		"tsdown": "^0.22.14",
		"typescript": "~5.9.3",
		"vitest": "^4.1.11",
		"wait-on": "^9.1.0"
	}
}
